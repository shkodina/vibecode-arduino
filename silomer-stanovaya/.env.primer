# Скопируй в .env и впиши свои значения.
# .env уже указан в корневом .gitignore.

WIFI_SSID=MoyaWiFiSet
WIFI_PASS=moy-skrytyy-parol

# Для WSL обычно COM-порт Windows, например COM4.
# Для linux-режима обычно /dev/ttyUSB0 или /dev/ttyACM0.
PORT=COM4

# wsl или linux
REZHIM=wsl

# Обычно менять не нужно.
# PLATA=esp8266:esp8266:nodemcuv2
# WINDOWS_CLI=/mnt/c/Program Files/Arduino IDE/resources/app/lib/backend/resources/arduino-cli.exe
# WINDOWS_PAPKA=/mnt/c/Users/USERNAME/arduino-wsl/silomer-stanovaya
# WINDOWS_PUT=C:\Users\USERNAME\arduino-wsl\silomer-stanovaya
