# Пример настроек. Скопировать в .env и вписать свои значения:
#     cp .env.primer .env
#
# Файл .env в git не попадает, он прописан в .gitignore.

# Имя домашней сети и пароль от неё.
WIFI_SSID=MoyaSet
WIFI_PASS=moy-parol

# Порт, на котором видна плата.
#   для линукса это что-то вида /dev/ttyUSB0
#   для режима wsl это виндовый порт, например COM4
PORT=/dev/ttyUSB0

# Режим сборки:
#   linux - обычный, работает линуксовый arduino-cli
#   wsl   - порт виден только Windows, работаем виндовым arduino-cli.exe
REZHIM=linux
