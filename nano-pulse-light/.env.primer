# Пример настроек. Скопировать в .env:
#     cp .env.primer .env
#
# Файл .env в git не попадает.

# Порт, на котором видна плата.
#   для линукса это что-то вида /dev/ttyUSB0
#   для режима wsl это виндовый порт, например COM4
PORT=COM4

# Режим сборки:
#   linux - обычный, работает линуксовый arduino-cli
#   wsl   - порт виден только Windows, работаем виндовым arduino-cli.exe
REZHIM=wsl

# Загрузчик Nano. Старый - для большинства клонов с CH340.
# Если avrdude не может связаться - попробуй atmega328 (новый).
# PLATA=arduino:avr:nano:cpu=atmega328old
# PLATA=arduino:avr:nano:cpu=atmega328
